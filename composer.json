{
    "name": "jackardios/laravel-query-wizard",
    "description": "Laravel Query Wizard",
    "keywords": [
        "jackardios",
        "laravel-query-builder",
        "laravel-query-wizard",
        "laravel",
        "query",
        "wizard",
        "builder",
        "json",
        "api",
        "json api",
        "query builder"
    ],
    "homepage": "https://github.com/jackardios/laravel-query-wizard",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/jackardios/laravel-query-wizard/issues",
        "source": "https://github.com/jackardios/laravel-query-wizard"
    },
    "authors": [
        {
            "name": "Salavat Salakhutdinov",
            "email": "salavat.salahutdinov@gmail.com",
            "homepage": "https://github.com/jackardios"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.61.1 || ^13.12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pint": "1.30.4",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.50 || ^12.5.8",
        "staudenmeir/belongs-to-through": "^2.17"
    },
    "autoload": {
        "psr-4": {
            "Jackardios\\QueryWizard\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jackardios\\QueryWizard\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:feature": "phpunit --testsuite=Feature",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format-check": "pint --test",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jackardios\\QueryWizard\\QueryWizardServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
